{
  "name": "openbeats",
  "private": true,
  "version": "1.0.5",
  "description": "OpenBeats — an open-source beatmaking studio with an FL-style workflow",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
