# Maintainer: OpenBeats maintainers <blsphmicwillow@users.noreply.github.com>
pkgname=openbeats-bin
pkgver=1.0.8
pkgrel=1
pkgdesc='Open-source beatmaking studio (native Tauri build)'
arch=('x86_64')
url='https://github.com/blsphmicwillow/OpenBeats'
license=('GPL-3.0-or-later')
depends=(
  'gtk3'
  'gstreamer'
  'gst-plugins-base'
  'gst-plugins-good'
  'gst-plugins-bad'
  'gst-plugins-ugly'
  'gst-libav'
  'libpulse'
  'pulse-native-provider'
  'alsa-lib'
  'libayatana-appindicator'
  'librsvg'
  'openssl'
  'xdg-utils'
  'hicolor-icon-theme'
)
optdepends=(
  'noto-fonts: recommended UI fonts'
)
provides=('openbeats')
conflicts=('openbeats' 'openbeats-git')
options=('!strip')
source=("openbeats-${pkgver}.AppImage::https://github.com/blsphmicwillow/OpenBeats/releases/download/v${pkgver}/OpenBeats_${pkgver}_amd64.AppImage")
sha256sums=('c189a465b7ddd83827905be36fb45957be86a1f5257dbe1f505e6173d68e3dce')

prepare() {
  cd "$srcdir"
  chmod +x "openbeats-${pkgver}.AppImage"
  rm -rf squashfs-root
  "./openbeats-${pkgver}.AppImage" --appimage-extract >/dev/null
}

package() {
  install -d "$pkgdir/opt/openbeats" "$pkgdir/usr/bin"
  cp -a "$srcdir/squashfs-root/." "$pkgdir/opt/openbeats/"

  # appimagetool's AppRun resolves apprun-hooks from the directory containing
  # the invoked path. A symlink makes it look in /usr/bin, so use a launcher
  # that invokes AppRun at its real location instead.
  cat > "$pkgdir/usr/bin/openbeats" <<'EOF'
#!/bin/sh
exec /opt/openbeats/AppRun "$@"
EOF
  chmod 755 "$pkgdir/usr/bin/openbeats"

  # The extracted AppImage root/apprun-hooks can be mode 700; make the
  # installed tree readable and traversable for the user running the app.
  chmod -R a+rX "$pkgdir/opt/openbeats"

  install -Dm644 "$srcdir/squashfs-root/usr/share/applications/OpenBeats.desktop" \
    "$pkgdir/usr/share/applications/openbeats.desktop"
  install -Dm644 "$srcdir/squashfs-root/OpenBeats.png" \
    "$pkgdir/usr/share/icons/hicolor/256x256/apps/openbeats.png"
}
