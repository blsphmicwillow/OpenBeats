{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenBeats",
  "version": "1.0.0",
  "identifier": "studio.openbeats.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OpenBeats — Open-source beatmaking studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; media-src 'self' data: blob: mediastream:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://api.github.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Music",
    "shortDescription": "Open-source beatmaking studio",
    "longDescription": "OpenBeats is an original, open-source beatmaking studio: channel rack, playlist, piano roll and routing mixer with built-in instruments and effects.",
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    },
    "resources": []
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/openbeats/openbeats/releases/latest/download/latest.json"],
      "pubkey": ""
    }
  }
}
