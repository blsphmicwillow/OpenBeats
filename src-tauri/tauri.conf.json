{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenBeats",
  "version": "1.0.4",
  "identifier": "studio.openbeats.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OpenBeats — Open-source beatmaking studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": true
      },
      {
        "label": "splash",
        "url": "splash.html",
        "title": "OpenBeats",
        "width": 480,
        "height": 320,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "center": true,
        "skipTaskbar": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; media-src 'self' data: blob: mediastream:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://api.github.com https://raw.githubusercontent.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Music",
    "shortDescription": "Open-source beatmaking studio",
    "longDescription": "OpenBeats is an original, open-source beatmaking studio: channel rack, playlist, piano roll and routing mixer with built-in instruments and effects.",
    "linux": {
      "appimage": {
        "bundleMediaFramework": true,
        "files": {
          "/usr/share/applications/OpenBeats.desktop": "appimage/OpenBeats.desktop"
        }
      },
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libgstreamer1.0-0",
          "gstreamer1.0-plugins-base",
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-plugins-bad",
          "gstreamer1.0-plugins-ugly",
          "gstreamer1.0-libav",
          "gstreamer1.0-pulseaudio",
          "gstreamer1.0-alsa",
          "pipewire-pulse | pulseaudio"
        ]
      },
      "rpm": {
        "depends": [
          "gstreamer1",
          "gstreamer1-plugins-base",
          "gstreamer1-plugins-good",
          "gstreamer1-plugins-bad-free",
          "gstreamer1-plugins-ugly-free",
          "gstreamer1-plugin-libav",
          "(pipewire-pulseaudio or pulseaudio)"
        ]
      }
    },
    "windows": {
      "bundleVCRuntime": true,
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      }
    },
    "resources": []
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/blsphmicwillow/OpenBeats/releases/latest/download/latest.json"],
      "pubkey": ""
    }
  }
}
